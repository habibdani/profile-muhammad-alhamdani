# Server only — NEVER prefix any secret with VITE_. Set these in Vercel Production.
SITE_URL=https://your-portfolio.vercel.app
UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
REPORT_FROM=Portfolio <onboarding@resend.dev>
# Generate two DIFFERENT secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
ANALYTICS_HASH_SECRET=

# Local testing only. Leave false for normal UI development and production.
ENABLE_LOCAL_ANALYTICS=false
VITE_ENABLE_LOCAL_ANALYTICS=false
